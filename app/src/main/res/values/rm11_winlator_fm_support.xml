<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Winlator 11.2 original layout dependencies, isolated RM11 theme. -->
    <attr name="colorPrimaryVariant" format="color" />
    <attr name="colorSecondaryVariant" format="color" />
    <attr name="colorSecondaryText" format="color" />
    <style name="RM11WinlatorFileManagerTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimaryVariant">#F1F5FF</item>
        <item name="colorSecondaryVariant">#46618C</item>
        <item name="colorSecondaryText">#B9C8DD</item>
        <item name="android:colorAccent">#3980D0</item>
        <item name="colorAccent">#3980D0</item>
        <item name="android:windowBackground">#101925</item>
    </style>
    <style name="LeftSideButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="RightSideButton" parent="LeftSideButton" />
    <item type="drawable" name="icon_run">@android:drawable/ic_media_play</item>
    <item type="drawable" name="icon_list_item_menu">@android:drawable/ic_menu_more</item>
</resources>
